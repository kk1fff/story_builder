{
  "name": "story-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/backend/server/main.js",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/**/*.spec.ts'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@xyflow/react": "^13.0.2",
    "express": "^5.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
